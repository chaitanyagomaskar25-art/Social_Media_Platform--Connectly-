# ==============================================================================
# Connectly Backend Environment Configuration (Template)
# Duplicate this file to .env and fill in your credentials.
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=3000

# Client Application URL (Configures CORS allowed origins)
FRONTEND_URL=http://localhost:5173

# Database Connection (Local MongoDB instance or MongoDB Atlas cluster connection URI)
MONGO_URI=mongodb://127.0.0.1:27017/connectly

# JWT Authentication Secrets (Generate secure random 64-char hex strings)
ACCESS_TOKEN=your_secure_access_token_secret
REFRESH_TOKEN=your_secure_refresh_token_secret

# Admin User Permissions (Comma-separated emails that receive admin privileges upon registration)
ADMIN_EMAILS=admin@connectly.app

# Cloudinary Media Storage (Required for user avatars, post images/videos, and 24h stories)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini API Key (Required for AI moderation / GenAI features)
API_KEY=your_gemini_api_key
